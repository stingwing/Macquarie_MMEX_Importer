<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MMEX-style coin (blue, with an orange "import" arrow) so it's distinguishable from MMEX itself. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The test project lives in a subfolder; keep its sources out of the app build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);MoneyManagerExMAQ.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded too, so the window/taskbar icon gets every size (ApplicationIcon only brands the .exe). -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="MoneyManagerExMAQ.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

</Project>